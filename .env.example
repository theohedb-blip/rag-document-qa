# Copy to .env and fill in your key(s). .env is git-ignored; never commit it.
# Comments are on their own lines so this file also works with `docker run --env-file`.

# --- OpenAI ------------------------------------------------------------------
# One OpenAI key is used for both embeddings and answers.
OPENAI_API_KEY=

# --- Models ------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Storage -----------------------------------------------------------------
# Defaults to data/chroma locally and /data/chroma in Docker; uncomment to override.
# CHROMA_DIR=data/chroma
COLLECTION_NAME=documents

# --- Retrieval ---------------------------------------------------------------
# Max characters per chunk, and characters shared between neighbouring chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=150
# Chunks retrieved per question
TOP_K=4
# Cosine similarity below which the API answers "not found" without calling the LLM.
# Tuned on the sample with: python eval/run_eval.py --sweep
MIN_SCORE=0.35

MAX_UPLOAD_MB=20
